# Copy outside the checkout and edit. This is trusted Bash configuration.
export WILDFIRE_REPO="/path/to/wildfire-research-plan"
export WILDFIRE_ROOT="/path/to/research artifacts"
export WILDFIRE_UPSTREAM="$WILDFIRE_ROOT/upstream/WildfireSpreadTS"
export WILDFIRE_DATA="$WILDFIRE_ROOT/data/wstsplus-active-fixed"
export WILDFIRE_STATS="$WILDFIRE_ROOT/data/train-2016-2020-stats.npz"
export WILDFIRE_B3_CHECKPOINT="$WILDFIRE_ROOT/checkpoints/b3.ckpt"
export WILDFIRE_B5_CHECKPOINT="$WILDFIRE_ROOT/checkpoints/b5.ckpt"
export WILDFIRE_TEACHER_MANIFEST="$WILDFIRE_ROOT/checkpoints/teachers.json"
# Interpreter commands must exist after the matching module list is loaded.
export WILDFIRE_TRAIN_PYTHON=python3.10
export WILDFIRE_AUDIT_PYTHON=python3.13
# Space-separated module names; empty means use the current toolchain.
export WILDFIRE_TRAIN_MODULES=""
export WILDFIRE_AUDIT_MODULES=""
# Edit arrays for your scheduler; add account/partition/GPU flags as appropriate.
WILDFIRE_CPU_SBATCH=(--cpus-per-task=4 --mem=16G --time=02:00:00)
WILDFIRE_GPU_SBATCH=(--cpus-per-task=8 --mem=48G --time=04:00:00 --gpus=1)
export WILDFIRE_PIP_INDEX_URL=https://pypi.org/simple
